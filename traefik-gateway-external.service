[Unit]
Description=Traefik Gateway External (Docker -traefik-gateway-external)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5

# Reconcile and verify the private WAF container before accepting public traffic.
ExecStartPre=/usr/bin/bash /nas-sync/waf-external-azure/docker-start.sh

# Recreate Traefik with the pinned image and current mounts, then attach logs.
ExecStartPre=/usr/bin/bash /nas-sync/traefik-gw-external-azure/docker-start.sh
ExecStart=/usr/bin/docker logs -f traefik-gateway-external

# Stop the public gateway before its private WAF dependency.
ExecStop=/usr/bin/docker stop traefik-gateway-external
ExecStop=-/usr/bin/docker stop modsecurity-waf-external

[Install]
WantedBy=multi-user.target